# --- Обязательные переменные ---------------------------------------------

# Токен Telegram-бота от @BotFather (/newbot -> скопировать токен)
BOT_TOKEN=123456:AA...

# API-ключ Новой Почты.
# Личный кабинет НП -> Настройки -> Безопасность -> Ключи API
NP_API_KEY=your_np_api_key

# --- Хранилище -----------------------------------------------------------

# Путь к файлу SQLite с кэшем справочников.
# ВАЖНО: на Railway файловая система эфемерная — БД сотрётся при редеплое.
# Смонтируйте Railway Volume на /data и укажите путь на нём:
#   DB_PATH=/data/np.db
# Локально можно оставить относительный путь.
DB_PATH=np.db

# --- Геокодер ------------------------------------------------------------

# Обязательный осмысленный User-Agent с контактом — иначе Nominatim
# забанит по IP. Укажите название проекта и рабочий email.
GEOCODER_USER_AGENT=np-cargo-bot/1.0 (contact: you@example.com)

# Провайдер геокодинга: пока поддержан "nominatim".
GEOCODER_PROVIDER=nominatim

# --- Прочее --------------------------------------------------------------

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
